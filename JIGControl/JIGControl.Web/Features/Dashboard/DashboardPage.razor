@page "/"
@attribute [Authorize]
@using JIGControl.Web.Features.Reports
@using JIGControl.Web.Features.Inventory
@inject MonthCardsHandler MonthCards
@inject ListMissingHandler ListMissing
@inject ListScannedHandler ListScanned
@inject NavigationManager Nav

<PageTitle>Dashboard</PageTitle>

<h1 class="page-title">Welcome, @name</h1>

<div class="kpi-row">
    <FluentCard Class="kpi">
        <div class="kpi-label">Scanned this month · @section</div>
        <div class="kpi-value">@(scannedNow?.ToString() ?? "…")</div>
    </FluentCard>
    <FluentCard Class="kpi kpi-warn">
        <div class="kpi-label">Missing this month · @section</div>
        <div class="kpi-value">@(missingNow?.ToString() ?? "…")</div>
    </FluentCard>
    <FluentCard Class="kpi kpi-action" @onclick="@(() => Nav.NavigateTo("/scan"))">
        <FluentIcon Value="@(new Icons.Regular.Size32.BarcodeScanner())" Color="Color.Accent" />
        <div class="kpi-label">Start scanning</div>
    </FluentCard>
</div>

<h2 class="section-title">@DateTime.Now.Year by month (all sections)</h2>
@if (cards is null)
{
    <FluentProgressRing />
}
else if (cards.Count == 0)
{
    <p class="muted">No scans recorded this year yet.</p>
}
else
{
    <div class="month-grid">
        @foreach (var c in cards)
        {
            <FluentCard Class="month-card">
                <div class="month-name">@Lookups.Months[c.ScanMonth - 1]</div>
                <div class="month-pct">@c.Percentage%</div>
                <div class="bar-track"><div class="bar-fill" style="width:@(Math.Min(100, c.Percentage).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div></div>
                <div class="muted">@c.TotalScanned of @c.TotalMaster JIGs</div>
            </FluentCard>
        }
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;

    private string name = "";
    private string section = "";
    private int? scannedNow, missingNow;
    private List<MonthCard>? cards;

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth).User;
        name = user.DisplayName();
        section = user.Section();
        var now = DateTime.Now;
        scannedNow = (await ListScanned.Handle(section, now.Year, now.Month)).Count;
        missingNow = (await ListMissing.Handle(section, now.Year, now.Month)).Count;
        cards = await MonthCards.Handle(now.Year);
    }
}
