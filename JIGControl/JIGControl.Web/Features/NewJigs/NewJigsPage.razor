@page "/new-jigs"
@attribute [Authorize]
@using JIGControl.Web.Features.Jigs
@inject NewJigCountsHandler Counts
@inject ListNewJigsHandler ListNew

<PageTitle>New JIGs</PageTitle>

<div class="ribbon">
    <FluentNumberField TValue="int" @bind-Value="year" @bind-Value:after="LoadYearAsync" Min="2020" Max="2100" Style="width:110px" />
    <FluentCheckbox @bind-Value="allSections" @bind-Value:after="LoadYearAsync" Label="All sections" />
    <FluentDivider Orientation="Orientation.Vertical" Style="height:24px" />
    <FluentAnchor Appearance="Appearance.Stealth" IconStart="@(new Icons.Regular.Size20.ArrowDownload())" Href="@ExportUrl" Target="_blank">Export @Lookups.Months[month - 1]</FluentAnchor>
</div>

<h1 class="page-title">New JIGs <span class="muted">· @(allSections ? "All sections" : section) · @year</span></h1>

@if (counts is null)
{
    <FluentProgressRing />
}
else
{
    <div class="muted" style="margin-bottom:8px">@counts.Sum() JIGs added in @year. Pick a month to see them.</div>
    <div class="month-grid">
        @for (var m = 1; m <= 12; m++)
        {
            var mm = m;
            <FluentCard Class="@($"month-card month-pick{(mm == month ? " month-active" : "")}")" @onclick="@(() => SelectMonthAsync(mm))">
                <div class="month-name">@Lookups.Months[mm - 1]</div>
                <div class="month-pct">@counts[mm - 1]</div>
                <div class="muted">new @(counts[mm - 1] == 1 ? "JIG" : "JIGs")</div>
            </FluentCard>
        }
    </div>

    <h2 class="section-title">Added in @Lookups.Months[month - 1] @year (@(rows?.Count ?? 0))</h2>
    @if (rows is null)
    {
        <FluentProgressRing />
    }
    else if (rows.Count == 0)
    {
        <p class="muted">No JIGs were added this month.</p>
    }
    else
    {
        <FluentDataGrid Items="rows.AsQueryable()" Pagination="pager" ShowHover="true">
            <PropertyColumn Property="@(r => r.DateAdded)" Title="Date Added" Format="yyyy-MM-dd HH:mm" Sortable="true" IsDefaultSortColumn="true" InitialSortDirection="SortDirection.Descending" />
            <PropertyColumn Property="@(r => r.ControlNo)" Title="Control No" Sortable="true" />
            <PropertyColumn Property="@(r => r.Partcode)" Title="Part Code" Sortable="true" />
            <PropertyColumn Property="@(r => r.Partname)" Title="Part Name" Sortable="true" />
            @if (allSections)
            {
                <PropertyColumn Property="@(r => r.Section)" Title="Section" Sortable="true" />
            }
            <TemplateColumn Title="Status">
                <StatusBadge Status="@context.Status" />
            </TemplateColumn>
            <TemplateColumn Title="">
                <FluentAnchor Appearance="Appearance.Hypertext" Href="@($"/jigs/{context.JigId}")">Open</FluentAnchor>
            </TemplateColumn>
        </FluentDataGrid>
        <FluentPaginator State="pager" />
    }
}

@code {
    [CascadingParameter] private Task<AuthenticationState> Auth { get; set; } = default!;

    private int year = DateTime.Now.Year;
    private int month = DateTime.Now.Month;
    private bool allSections;
    private string section = "";
    private int[]? counts;
    private List<NewJigRow>? rows;
    private readonly PaginationState pager = new() { ItemsPerPage = 15 };

    private string? SectionFilter => allSections ? null : section;
    private string ExportUrl => $"/reports/export?kind=new&year={year}&month={month}{(allSections ? "&all=true" : "")}";

    protected override async Task OnInitializedAsync()
    {
        section = (await Auth).User.Section();
        await LoadYearAsync();
    }

    private async Task LoadYearAsync()
    {
        counts = await Counts.Handle(SectionFilter, year);
        rows = await ListNew.Handle(SectionFilter, year, month);
    }

    private async Task SelectMonthAsync(int m)
    {
        month = m;
        rows = null;
        rows = await ListNew.Handle(SectionFilter, year, month);
        await pager.SetCurrentPageIndexAsync(0);
    }
}
